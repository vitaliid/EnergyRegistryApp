<?xml version="1.0" encoding="UTF-8"?>
<!-- Declares a root element per DIN 91379 datatype (A-E) so that a text can be validated against it. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:din="urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08"
           targetNamespace="urn:example:din91379-validation"
           elementFormDefault="qualified">
    <xs:import namespace="urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08"
               schemaLocation="din-norm-91379-datatypes.xsd"/>
    <xs:element name="datatypeA" type="din:datatypeA"/>
    <xs:element name="datatypeB" type="din:datatypeB"/>
    <xs:element name="datatypeC" type="din:datatypeC"/>
    <xs:element name="datatypeD" type="din:datatypeD"/>
    <xs:element name="datatypeE" type="din:datatypeE"/>
</xs:schema>
